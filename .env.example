# ========================================================
# Ongrywolf Multi-Bot Platform Configuration (.env)
# ========================================================

# --------------------------------------------------------
# 1. Main Official Bot (Status: "Hosting on Ongrywolf")
# --------------------------------------------------------
BOT_TOKEN_MAIN=your_main_bot_token_here
BOT_CLIENT_ID_MAIN=your_main_bot_client_id_here
# Backward-compatibility fallback on Render:
# If BOT_TOKEN_MAIN is not set, DISCORD_TOKEN is used as fallback.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --------------------------------------------------------
# 2. Bot A (Status: "Hosting on Ongrywolf PRV")
# --------------------------------------------------------
BOT_TOKEN_A=your_bot_a_token_here
BOT_CLIENT_ID_A=your_bot_a_client_id_here

# --------------------------------------------------------
# General Platform Settings
# --------------------------------------------------------
COMMAND_PREFIX=!

# PostgreSQL Database Connection
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_bot

# Authorization
# Comma-separated Discord Role IDs allowed to execute staff/admin commands
# (Server Administrators always have permission)
AUTHORIZED_ROLE_IDS=123456789012345678,987654321098765432

# Limits
MAX_LOG_LENGTH=1000

# --------------------------------------------------------
# Management API Authentication (Render 1 <-> Render 2)
# --------------------------------------------------------
# Secret key required to authenticate management requests from the website (Render 2)
BOT_HOST_API_KEY=your_super_secret_host_key_shared_between_render_services

# HTTP Port for Render Web Service (Default: 4000 for Bot Host, or PORT from Render)
PORT=4000
