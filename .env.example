# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
COMMAND_PREFIX=!

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_bot

# Authorization
# Comma-separated Discord Role IDs authorized to create work logs (Administrators always have access)
# Example: 123456789012345678,987654321098765432
AUTHORIZED_ROLE_IDS=

# Work Log Configuration
# Maximum character length for a work log description (Discord embeds field max is 1024)
MAX_LOG_LENGTH=1000

# Optional: Port for health check HTTP server (useful when deploying on Render as a Web Service)
PORT=3000
