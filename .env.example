# ========================================================
# Ongrywolf Multi-Bot Platform Configuration (.env)
# ========================================================

# --------------------------------------------------------
# 1. Bot 1: Ongrywolf Manager (Work Logging & Channel Admin)
# --------------------------------------------------------
BOT_MANAGER_TOKEN=your_manager_bot_token_here
BOT_MANAGER_CLIENT_ID=your_manager_bot_application_id_here
# Backward-compatibility fallback:
# If BOT_MANAGER_TOKEN is not set, DISCORD_TOKEN is used as fallback.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --------------------------------------------------------
# 2. Bot 2: Ongrywolf Orders (Customer & Staff Orders)
# --------------------------------------------------------
BOT_ORDERS_TOKEN=your_orders_bot_token_here
BOT_ORDERS_CLIENT_ID=your_orders_bot_application_id_here

# --------------------------------------------------------
# General Platform Settings
# --------------------------------------------------------
COMMAND_PREFIX=!

# PostgreSQL Database Connection
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_bot

# Authorization
# Comma-separated Discord Role IDs allowed to execute staff/admin commands
# (Server Administrators always have permission)
AUTHORIZED_ROLE_IDS=123456789012345678,987654321098765432

# Limits
MAX_LOG_LENGTH=1000

# HTTP Port for Render Web Service health-check
PORT=3000
